# Template only. Run ./scripts/setup.sh to generate a real .env with random secrets.
POSTGRES_USER=smartsecure
POSTGRES_DB=smartsecure
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# API login users: name:scrypt.hash:role (setup.sh hashes the passwords). Plaintext is refused.
# Do not copy plaintext demo passwords onto a Pi. Roles: viewer | operator | admin.
API_USERS=admin:change_me:admin,viewer:change_me:viewer
# Plaintext only for local scripts (ws_listen). The API reads hashes from API_USERS.
API_ADMIN_PASSWORD=change_me
API_VIEWER_PASSWORD=change_me
# Swagger/OpenAPI at /docs. Off by default (the API port is reachable in the lab); set it to
# true only while you are developing against the schema. NEVER true on a gateway.
API_DOCS_ENABLED=false
DASHBOARD_PORT=8080
# AES-256-GCM key material for the API's at-rest encryption (libs/common/crypto.py).
STORAGE_KEY=change_me
MQTT_PASSWORD_ADMIN=change_me
MQTT_PASSWORD_API=change_me
MQTT_PASSWORD_SIMULATORS=change_me
MQTT_PASSWORD_VISION=change_me
MQTT_PASSWORD_CYBER=change_me
MQTT_PASSWORD_ENGINE=change_me

# --- simulators (Person 3). Optional: compose defaults to these values when unset.
# HAL_DRIVER=gpio uses real hardware for devices that have `gpio_pin` in devices.yaml (Pi phase).
HAL_DRIVER=sim
# MUST be false on real hardware: lets scenario/inject messages create fake sensor events.
SIM_ALLOW_INJECT=true

# --- engine (Person 6). Push notifications are optional; empty server = log only (dry-run).
# Use the compose ntfy profile, not public ntfy.sh, if alerts must stay in the house.
# NTFY_SERVER=http://ntfy:80
# NTFY_TOPIC=pick-a-long-random-topic-name     # install the ntfy app, subscribe to the same topic
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- cyber (Person 5). All optional; compose supplies these defaults. See services/cyber/README.md.
# ENGINE_ISOLATION=off              # off | shadow | on. on: at Critical the engine isolates a compromised device (outbound flow
#                                   from a known device IP). Try shadow first (it only logs "would isolate"). Needs a real firewall.
# CYBER_FIREWALL=blocklist           # demo. On a real gateway: nftables or iptables (needs root)
# CYBER_AUTOBLOCK=cyber.port_scan,cyber.brute_force   # empty = only block when the engine asks
# CYBER_AUTOBLOCK_S=600
# CYBER_NEVER_BLOCK=192.168.1.1      # gateway, DNS, your own laptop: comma-separated IPs/CIDRs
# ROGUE_ARP=false                    # also watch the ARP table (real gateway / Pi)

# --- vision (Person 4). Models are downloaded once with make vision-models.
# FIRE_IMGSZ must match the export size of services/vision/models/fire.onnx (800).
# Optional: point the pipeline at the RTSP demo camera instead of the video file.
# FIRE_IMGSZ=800
# VISION_SOURCE=rtsp://rtsp:8554/camera
