{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmartSecure IPS detection data",
  "description": "The data object of cyber.port_scan, cyber.brute_force, cyber.dos and cyber.unexpected_traffic (CONTRACT 3.1).",
  "type": "object",
  "required": [
    "src_ip",
    "dst_ip",
    "dst_port",
    "protocol",
    "direction",
    "device_id",
    "confidence",
    "mitre_technique",
    "failed_attempts",
    "connection_attempts",
    "duration"
  ],
  "properties": {
    "src_ip": {
      "type": "string",
      "minLength": 2,
      "maxLength": 45
    },
    "dst_ip": {
      "type": "string",
      "minLength": 2,
      "maxLength": 45
    },
    "dst_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "protocol": {
      "enum": [
        "TCP",
        "UDP",
        "ICMP",
        "GRE"
      ]
    },
    "direction": {
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "maxLength": 50
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mitre_technique": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
    },
    "failed_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "connection_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "details": {
      "type": "object"
    }
  }
}
